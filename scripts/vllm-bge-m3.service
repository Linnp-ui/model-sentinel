[Unit]
Description=vLLM serving bge-m3 embedding model (port 8001, GPU 4 shared with Qwen3-4B)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=your-user
WorkingDirectory=/home/your-user

# GPU 4 与 vllm-qwen3-4b 同卡（2026-09-16 T36b，用户指定合布 GPU4，腾空 GPU5）：
# bge util 0.10 + Qwen util 0.70 = 0.80，余 ~20% 给 CUDA 上下文与碎片。
# 旧址 GPU 5（2026-09-14 自 GPU 4 迁出）现已释放。
Environment=CUDA_VISIBLE_DEVICES=4
Environment=HOME=/home/your-user
Environment=HF_HUB_DISABLE_PROGRESS_BARS=1
Environment=VLLM_LOGGING_LEVEL=INFO

ExecStart=/home/your-user/venvs/vllm/bin/vllm serve /home/your-user/models/bge-m3 \
  --served-model-name bge-m3 \
  --host 0.0.0.0 \
  --dtype float16 \
  --gpu-memory-utilization 0.1 \
  --port 8001

Restart=on-failure
RestartSec=10
StartLimitBurst=10
StartLimitIntervalSec=60

StandardOutput=append:/home/your-user/bge_m3.log
StandardError=append:/home/your-user/bge_m3.log

[Install]
WantedBy=multi-user.target
