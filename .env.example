# 复制为 .env 后填写（.env 不进 git；本文件只有占位值）。
# 必填只有 AI_GATEWAY_DEV_API_KEY；完整变量表见 agents/env.md。
# 改 .env 需重启 gateway.service（policy/routing/model_policy/l2_overrides 四个 yaml 是热重载，不用重启）。
# 首次体验：起服务后开管理台 http://localhost:8080/admin（/ 会 302 过去），三行 curl 验证见 README。
# ---------------- 网关自身 ----------------
AI_GATEWAY_DEV_API_KEY=pk_live_dev_changeme
AI_GATEWAY_POLICY_PATH=./policy.yaml
AI_GATEWAY_ROUTING_PATH=./routing.yaml
# 单次请求 max_tokens 上限，0 表示不限制（调用方没给时默认 300）
AI_GATEWAY_MAX_TOKENS_CAP=0
# /admin* 端点允许的客户端 IP（逗号分隔）；默认只允许 localhost。生产内网改为办公网段，如 192.168.0.0/16
# 私有网段（10.* / 192.168.* / 169.254.*）和 loopback（127.* / ::1）始终放行
AI_GATEWAY_ADMIN_IP_ALLOWLIST=127.0.0.1,::1
# 用户自定义模型允许注册的外网域名白名单（逗号分隔，支持子域 *.domain）
AI_GATEWAY_EGRESS_DOMAINS=api.openai.com,api.deepseek.com,api.anthropic.com,dashscope.aliyuncs.com,open.bigmodel.cn,api.perplexity.ai,api.mistral.ai,generativelanguage.googleapis.com

# ---------------- 外网 provider 密钥（routing.yaml 里只存变量名） ----------------
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=

# ---------------- 内网模型（内容不出境） ----------------
OLLAMA_BASE_URL=http://10.0.0.10:8000/v1
OLLAMA_API_KEY=
# 内网向量模型 bge-m3
BGE_BASE_URL=http://10.0.0.10:8001/v1
BGE_API_KEY=
# 有真实内网模型就设为 false，否则 true 走 mock
OLLAMA_MOCK=false

# ---------------- L2 小模型（Qwen3-4B 语义二次判定） ----------------
SMALL_MODEL_URL=http://10.0.0.10:8002/v1/chat/completions
SMALL_MODEL_NAME=Qwen3-4B-Instruct-2507
SMALL_MODEL_TIMEOUT=5

# ---------------- 存储 ----------------
DATABASE_URL=mysql+pymysql://gateway:gateway@localhost:3306/gateway
REDIS_URL=redis://localhost:6379/0

# 对外只展示白名单里的模型（/v1/models 白名单，逗号分隔；空=不过滤）。
# 只影响客户端可发现性，不改变可路由性：未列出的名字仍可被点名调用。
# AI_GATEWAY_PUBLIC_MODELS=Auto-AB,local-model
